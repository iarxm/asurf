# init and meta data


_prn_h_srt()    { _prn_h "init sorting of dir [ ${src_srt} ]"; }

_prn_b_srt()    { _prn_b "sorting file [ ${src_srt_i} ]"; }

_prn_srt_r()    { _prn_b "dirname suffix?"; }

_srt_date_ini() { src_srt="${1}"; _prn_h_srt; }

_srt_date_read()
{
    _prn_srt_r
    read -r srt_sfx
}

_date_x()
{
    date --date="${1}" +%m%d%a |\
        awk '{print tolower($0)}' |\
        sed 's/.$//'
}

# srt: date/dnames: moving individual files

_srt_date_ini_x ()
{
    [ -f "${1}" ] || return 1
    f=${1}
    di="$(date -r "${f}" "+%D")"
    dh="$(date -r "${f}" "+%H")"

    if [ "${dh}" -lt 12 ]
    then
        xm="a"
    else
        xm="p" # am or pm
    fi

    dst_srt_date=$(_date_x "${di}")
}

_srt_date_ini_y()
{
    sbase=$(dirname "$f" | xargs dirname)
    sdirx="${dst_srt_date}${xm}-${srt_sfx}"
    sdir="${sbase}/${sdirx}"
    dst_srt="${sdir}/$(basename "${f}")"
}

_srt_date_mv_x()
{
    _prn_b "${f} -> ${dst_srt}"
    mkdir -p "${sdir}"
    mv "${f}" "${dst_srt}"
}

_srt_date_mv()
{
    _srt_date_ini_x "${1}"
    _srt_date_ini_y
    _srt_date_mv_x
}

# srt: src dir x containing files to be sorted

_srt_date_ini_i()
{
    src_srt_i="${1}"
    _prn_b_srt
}

_srt_date_ls()
{
    find "${src_srt_i}" -mindepth 1 -maxdepth 1 -type f -exec realpath {} \;
}

_srt_ls() { find "${src_srt_i}" -mindepth 1; }

_srt_date_ls_lp()
{
    for i in $(_srt_date_ls)
    do
        _srt_date_mv "${i}"
    done
}

_srt_date_clean()
{
    # clean empty dirs
    if [ -z "$(_srt_ls)" ]
    then
        trash-put "${src_srt_i}"
    else
        _prn_b "warning: files still in old dir [ ${src_srt_i} ], not trashing"
    fi
}

_srt_date_x()
{
    _srt_date_ini_i "${1}"
    _srt_date_ls_lp
    _srt_date_clean
}

# srt - src root containing src dir's

_srt_date_r_ls() { _find_d_grp "${src_srt}" "${sd_srt_pattern}"; }

_srt_date_r_lp()
{
    for d in $(_srt_date_r_ls)
    do
        _srt_date_x "${d}"
    done
}

_srt_date_r()
{
    _srt_date_ini "${@}"
    _srt_date_read
    _srt_date_r_lp
}

# srt sd

_srt_sd()
{
    [ -n "${sd_dcim}" ] || _sd_ini
    _srt_date_r "${sd_dcim}"
}

