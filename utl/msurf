# srt: date/dnames: moving individual files

_srt_date_ini_x ()
{
    [ -f "${1}" ] || return 1
    f=${1}
    di="$(date -r "${f}" "+%D")"
    dh="$(date -r "${f}" "+%H")"

    if [ "${dh}" -lt 12 ]
    then
        xm="a"
    else
        xm="p" # am or pm
    fi

    dst_srt_date=$(_date_x "${di}")
}

_srt_date_ini_y()
{
    sbase=$(dirname "$f" | xargs dirname)
    sdirx="${dst_srt_date}${xm}-${srt_sfx}"
    sdir="${sbase}/${sdirx}"
    dst_srt="${sdir}/$(basename "${f}")"
}

_srt_date_mv_x()
{
    _prn_b "${f} -> ${dst_srt}"
    mkdir -p "${sdir}"
    mv "${f}" "${dst_srt}"
}

_srt_date_mv()
{
    _srt_date_ini_x "${1}"
    _srt_date_ini_y
    _srt_date_mv_x
}

