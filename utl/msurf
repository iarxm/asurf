# init cfg

_ini()
{
    # loaded via config file
    declare -g rx # root work tree
    declare -g ry    # all years / trees
    declare -g dst_i_def
    declare -g rgx_sdx
    declare -g sd_srt_patterns
    declare -g sdx_mntx
    declare -g sd_bkp_suffix
    declare -g rep_o1_x
    declare -g rep_o1_y
    declare -g rep_g1_x
    declare -g rep_dv_b

    local config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
    local config_file="${config_home}/asurf/env"

    if [ ! -r "${config_file}" ]
    then
        _prn_b "configuration not found: ${config_file}"
        _prn_b "create it with rx, dst_i_def, SD discovery, and remote settings"
        exit 1
    fi
    # shellcheck source=/dev/null
    source "${config_file}"

    # set later
    declare -g psep=""
    declare -g prefix="MSURF"
    declare -g rgx_sd="${rgx_sdx}"
    declare -g sd_mnt="${sdx_mntx}"
    declare -g sd_srt_pattern="${sd_srt_patterns}"

    declare -g sd_i=""    # sd path as arg
    declare -g sd_m=""    # sd path auto matched
    declare -g sd_r=""    # sd root as final sd var
    declare -g sd_dcim="" # dcim
    declare -g sd_bkp=""

    declare -g r="$(realpath "${rx}")" # root work tree
    declare -g dst_i=""                # inputed sub dir
    declare -g dst=""                  # dst full path
}

_prn_l()     { printf "%s\n" " "; }

_prn_c()     { printf "%s\n" "${1}"; }

_prn_b()     { printf "%s\n" "${@}" ; }

_prn_h()
{
    printf "%s\n" \
        "# ${1}" \
        "${psep}"
}

_prn_h2()
{
    printf "%s\n" \
        "${psep}" \
        "# ${1}"
}

_exit1()
{
    _prn_b "exiting (code: 1)"
    exit 1
}

_a2b()
{
    [ -n "${2}" ] || return 0
    eval "${2}"="${!1}"
}

_find_d_grp()
{
    find "${1}" \
        -mindepth 1 \
        -maxdepth 1 \
        -type d \
        -regextype posix-extended \
        -regex ".*(${2})" \
        -exec realpath {} \;
            #| grep -E "${2}"
}

_find_d()
{
    find "${1}" -mindepth 1 -maxdepth 1 -type d -exec realpath {} \;
}

# mv

_rs()         { rsync -avP "$1" "$2"; }

_rc_syc()
{
    rclone sync \
        -vP \
        --track-renames \
        --create-empty-src-dirs \
        "${syc_src}" \
        "${syc_dst}"
}

_mv_loop()
{
    while IFS= read -r line
    do
        _prn_b "${line} -> ${2}/*"
        mv "${line}" "${2}/"
    done <<< "${1}"
}

# test

_tst_dir()
{
    local value="${!1}"
    _prn_b "checking whether dir exists [ ${value} ]"
    if [ -d "${value}" ]
    then
        printf -v "${2}" '%s' "${value}"
        return 0
    else
        _prn_b "failed to match dir [ ${1} ]; return 1"
        return 1
    fi
}

# sd

_set_sd_m()
{
    [ -d "${sd_mnt}" ] || return 1
    sd_m=$(_find_d_grp "${sd_mnt}/" "${rgx_sd}") # '../' required
}

_set_sd_i()
{
    [ -n "${sd_i}" ] || return 1
    if [[ "${sd_i}" = /* ]]
    then
        sd_i="$(realpath "${sd_i}")"
    else
        sd_i="$(realpath "${HOME}/${sd_i}")"
    fi
}

_sd_r_i()
{
    [ -d "${sd_r}" ] && return 0
    _set_sd_i
    [ -n "${sd_i}" ] || return 1
    _tst_dir sd_i sd_r
    [ "$?" -eq 0 ] && _prn_b "sd root has been set as the input arg"
}

_sd_r_m()
{
    [ -d "${sd_r}" ] && return 0
    _prn_l
    _set_sd_m
    [ -n "${sd_m}" ] || return 1
    _tst_dir sd_m sd_r
    [ "$?" -eq 0 ] && _prn_b "sd root has been set by regex"
}

_sd_set_dcim_x()
{
    [ -d "${sd_r}" ] || return 1
    sd_dcim="${sd_r}/DCIM/" 
}

# init asynchronous

_sd_ini_imp()
{
    if [ -z "${dst_i}" ]
    then
        dst_i="${dst_i_def}"
    else
        dst_i="${dst_i}"
    fi

    dst="$(realpath -m "${r}/${dst_i}")"
    case "${dst}" in
        "${r}"|"${r}"/*) ;;
        *)
            _prn_b "destination must be below workspace root [ ${r} ]"
            _exit1
            ;;
    esac
}

_sd_ini()
{
    sd_i="${1:-}"
    dst_i="${2:-}"
    _sd_ini_imp
    _sd_r_i
    _sd_r_m
    _sd_set_dcim_x
    [ -d "${sd_dcim}" ] || _exit1
}

_sd_prn()
{
    _sd_ini "${@}"
    _prn_l
    _prn_b "sd fed as input: ${sd_i}"
    _prn_b "sd regex matched: ${sd_m}"
    _prn_b "dcim set: ${sd_dcim}"
}

# sd_mv

_sd_rs()
{
    mkdir -p "${dst}"
    _rs "${sd_dcim}/" "${dst}/"
}
   
_sd_bkp_ini()
{
    sd_bkp_src="$(_find_d "${sd_dcim}")"
    sd_bkp="${sd_bkp:-${sd_r}/${sd_bkp_suffix}}"
    mkdir -p "${sd_bkp}"
    _prn_h "sd bkp"
}

_sd_bkp()
{
    [ -d "${sd_dcim}" ] || _sd_ini "${@}"
    _sd_bkp_ini
    _mv_loop "${sd_bkp_src}" "${sd_bkp}"
}

_sd_mvx ()
{
    # Positional `sd mv` may use configured card discovery; make a newly
    # inserted card available before that discovery is attempted.
    [ -n "${1:-}" ] || _sd_mount || return 1
    _sd_ini "${@}"
    _sd_rs || return 1
    _sd_bkp
}

_sd_mount()
{
    command -v lsblk >/dev/null || { _prn_b "lsblk is required to find SD cards"; return 1; }
    command -v udisksctl >/dev/null || { _prn_b "udisksctl is required to mount SD cards"; return 1; }

    if [ "$#" -gt 1 ]
    then
        _prn_b "mount accepts at most one block-device path"
        return 1
    fi

    if [ "$#" -eq 1 ]
    then
        case "$1" in
            /dev/*) ;;
            *)
                _prn_b "block-device path must start with /dev/: $1"
                return 1
                ;;
        esac
        _prn_b "mounting requested block device: $1"
        udisksctl mount -b "$1" || {
            _prn_b "mount failed; check that udisksd and your desktop login session are active"
            return 1
        }
        return 0
    fi

    local dev type removable mounted is_card found=0
    while read -r dev type removable mounted
    do
        [ "${type}" = "part" ] || continue
        is_card=0
        [ "${removable}" = "1" ] && is_card=1
        # Built-in SD readers are commonly exposed as mmcblk devices with
        # RM=0, even though their partitions are removable media.
        case "${dev}" in
            /dev/mmcblk*p[0-9]*) is_card=1 ;;
        esac
        [ "${is_card}" -eq 1 ] || continue
        found=1
        if [ -n "${mounted}" ]
        then
            _prn_b "already mounted: ${dev} -> ${mounted}"
        else
            _prn_b "mounting removable card partition: ${dev}"
            udisksctl mount -b "${dev}" || {
                _prn_b "mount failed; check that udisksd and your desktop login session are active"
                return 1
            }
        fi
    done < <(lsblk -pnro NAME,TYPE,RM,MOUNTPOINT)

    [ "${found}" -eq 1 ] || _prn_b "no removable or MMC SD-card partitions found"
}

_sd_cp()
{
    local cp_dir="" cp_subdir="" cp_sd="" cp_mount=0

    while [ "$#" -gt 0 ]
    do
        case "$1" in
            help|--help|-h) _help_sd_cp; return 0 ;;
            --dir|--subdir|--source|--sd)
                if [ "$#" -lt 2 ] || [ -z "$2" ]
                then
                    _prn_b "$1 requires a value"
                    return 1
                fi
                case "$1" in
                    --dir) cp_dir="$2" ;;
                    --subdir) cp_subdir="$2" ;;
                    --source|--sd) cp_sd="$2" ;;
                esac
                shift 2
                ;;
            --mount)  cp_mount=1; shift ;;
            *)
                _prn_b "unknown cp option: $1"
                _help
                return 1
                ;;
        esac
    done

    # An unqualified import is the normal coaching workflow: take the detected
    # card and place it in the configured default inbox. A supplied subdir is
    # appended to either the configured default or an explicit --dir.
    cp_dir="${cp_dir:-${dst_i_def}}"
    [ -n "${cp_subdir}" ] && cp_dir="${cp_dir}/${cp_subdir}"

    # Auto-source copies should make a newly inserted card available before
    # trying the configured mount-point discovery. _sd_mount leaves an already
    # mounted card alone, so this is safe on every normal `sd cp` invocation.
    if [ -z "${cp_sd}" ] || [ "${cp_mount}" -eq 1 ]
    then
        _sd_mount || return 1
    fi

    _sd_ini "${cp_sd}" "${cp_dir}"
    _sd_rs
}

_sd_mv()
{
    local mv_dir="" mv_subdir="" mv_sd="" mv_mount=0
    local -a positional=()

    while [ "$#" -gt 0 ]
    do
        case "$1" in
            help|--help|-h) _help_sd_mv; return 0 ;;
            --dir|--subdir|--source|--sd)
                if [ "$#" -lt 2 ] || [ -z "$2" ]
                then
                    _prn_b "$1 requires a value"
                    return 1
                fi
                case "$1" in
                    --dir) mv_dir="$2" ;;
                    --subdir) mv_subdir="$2" ;;
                    --source|--sd) mv_sd="$2" ;;
                esac
                shift 2
                ;;
            --mount) mv_mount=1; shift ;;
            --*)
                _prn_b "unknown mv option: $1"
                _help_sd_mv
                return 1
                ;;
            *) positional+=("$1"); shift ;;
        esac
    done

    if [ "${#positional[@]}" -gt 2 ]
    then
        _prn_b "mv accepts at most SD_ROOT and DESTINATION positional arguments"
        return 1
    fi

    [ -n "${mv_sd}" ] || [ "${#positional[@]}" -eq 0 ] || mv_sd="${positional[0]}"

    if [ -n "${mv_dir}" ] || [ -n "${mv_subdir}" ]
    then
        mv_dir="${mv_dir:-${dst_i_def}}"
        [ -n "${mv_subdir}" ] && mv_dir="${mv_dir}/${mv_subdir}"
    elif [ "${#positional[@]}" -gt 1 ]
    then
        mv_dir="${positional[1]}"
    fi

    [ "${mv_mount}" -eq 0 ] || _sd_mount || return 1
    _sd_mvx "${mv_sd}" "${mv_dir}"
}

_all_xa()
{
    _srt_sd "${@}"
    _sd_mvx "${@}"
}

_all_xb()
{
    _all_xa "${@}"
}

_all_xc()
{
    local sd_root="${1:-}" destination="${2:-}" sync_path="${3:-${destination}}"
    _all_xb "${sd_root}" "${destination}" || return 1
    _syc_o1_x "${sync_path}"
}

_all_sd()
{
    _srt_sd "${@}"
    _sd_mvx "${@}"
}

_sd_command()
{
    local sd_subcommand="${1:-}"
    [ "$#" -gt 0 ] && shift

    case "${sd_subcommand}" in
        mount)             _sd_mount "${@}" ;;
        cp|import)         _sd_cp "${@}" ;;
        prn|print)         _sd_prn "${@}" ;;
        mv|move)           _sd_mv "${@}" ;;
        bkp|backup)        _sd_bkp "${@}" ;;
        all)               _all_sd "${@}" ;;
        macro-a)           _all_xa "${@}" ;;
        help|--help|-h|'') _help_sd ;;
        *)
            _prn_b "unknown sd subcommand: ${sd_subcommand}"
            _help
            return 2
            ;;
    esac
}

