}

# meta sort

_srt_sz10()  { _srt_size 0M  11M  "${@}" ; }
_srt_sz60()  { _srt_size 30M 61M  "${@}" ; }
_srt_sz200() { _srt_size 60M 200M "${@}" ; }

_srt_siz_all()
{
    sort_size 0M  11M  "${1}"
    sort_size 10M 31M  "${1}"
    sort_size 30M 61M  "${1}"
    sort_size 60M 200M "${1}"
}

# sort: client profiles

_src_cl_ls()
{
    find "${src_cl_r}" \
        -mindepth 1 -maxdepth 1 -name "*${pattern_cl}\.*"
}

_mv2cl_ini()
{
    src_cl_r="${1}"
    dst_cl_r="${2}"
    pattern_cl="${3}*" # client annotation pattern
    
    dst_cl_d="$(basename "${src_cl_r}")"
    dst_cl_rx="${dst_cl_r}/${dst_cl_d}"
    src_cl_ls=$(_src_cl_ls)
    echo "src $src_cl_r"
    
    if [ -n "${src_cl_ls}" ]
    then
        mkdir -p "${dst_cl_r}"
        mkdir -p "${dst_cl_rx}"
    else
        _prn_b "nothing to move of pattern ${pattern_cl}"
        return 1
    fi
}

_mv2cl_x_ini()
{
    src_cl_i="${1}"
    dst_cl_i="${dst_cl_rx}/$(basename "${src_cl_i}")"
}

_mv2cl_x()
{
    # session(y) -> client(x)
    _mv2cl_x_ini "${1}"
    _prn_b "${src_cl_i} -> ${dst_cl_i}"
    mv "${src_cl_i}" "${dst_cl_i}"
}

_mv2cl_lp()
{
    _prn_b "moving pattern ${pattern_cl}"
    for i in ${src_cl_ls}
    do
        _mv2cl_x "${i}"
    done
}

_mv2cl()
{
    _mv2cl_ini "${@}"
    [ $? -eq 1 ] && return
    _mv2cl_lp
}

# sync

_syc_ini()
{
    r_c="${1}"
    i="${2}"
    syc_src="${r}/${i}"
    syc_dst="${r_c}/${i}"
}

_syc_x()
{
    _syc_ini "${@}"
    _prn_h "rclone sync to < ${syc_src} >"
    _rc_syc
}

_syc_g1_x () { _syc_x "${rep_g1_x}" "${1}" ; }

_syc_o1_x () { _syc_x "${rep_o1_x}" "${1}" ; }

_syc_o1_y () { _syc_x "${rep_o1_y}" "${1}" ; }

_syc_dv_b () { _syc_x "${rep_dv_b}" "${1}" ; }

_syc_22_()
{
    sfx="x22a/${2}"
    syc_src="${ry}/${sfx}"
    syc_dst="${r_c}/${sfx}"
    _prn_h "rclone sync to < ${syc_src} >"
    _rc_syc
}

