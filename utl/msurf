# TASK set personal configs via external file (migrate to python and use a config modulde...)

_ini()
{
    # loaded via config file
    declare -g rx # root work tree
    declare -g ry    # all years / trees
    declare -g dst_i_def
    declare -g rgx_sdx
    declare -g sd_srt_patterns
    declare -g sdx_mntx
    declare -g sd_bkp_suffix
    declare -g rep_o1_x
    declare -g rep_o1_y
    declare -g rep_g1_x
    declare -g rep_dv_b

    source "${XDG_CONFIG_HOME}/asurf/env"

    # set later
    declare -g psep=""
    declare -g prefix="MS"
    declare -g rgx_sd="${rgx_sdx}"
    declare -g sd_mnt="${sdx_mntx}"

    declare -g sd_i=""    # sd path as arg
    declare -g sd_m=""    # sd path auto matched
    declare -g sd_r=""    # sd root as final sd var
    declare -g sd_dcim="" # dcim
    declare -g sd_bkp=""

    declare -g r="$(realpath "${rx}")" # root work tree
    declare -g dst_i=""                # inputed sub dir
    declare -g dst=""                  # dst full path
}

_prn_l()     { printf "${prefix}:%s\n" " "; }

_prn_c()     { printf "%s\n" "${1}"; }

_prn_b()     { printf "${prefix}: %s\n" "${@}" ; }

_prn_h()
{
    printf "${prefix}: %s\n" \
        "${psep}" \
        "# ${1}" \
        "${psep}"
}

_prn_h2()
{
    printf "${prefix}: %s\n" \
        "${psep}" \
        "# ${1}"
}

_exit1()
{
    _prn_b "exiting (code: 1)"
    exit 1
}

_a2b()
{
    [ -n "${2}" ] || return 0
    eval "${2}"="${!1}"
}

_find_d_grp()
{
    find "${1}" \
        -mindepth 1 \
        -maxdepth 1 \
        -type d \
        -regextype posix-extended \
        -regex ".*${2}" \
        -exec realpath {} \;
            #| grep -E "${2}"
}

_find_d()
{
    find "${1}" -mindepth 1 -maxdepth 1 -type d -exec realpath {} \;
}

# mv

_rs()         { rsync -avP "$1" "$2"; }

_rc_syc()
{
    rclone sync \
        -vP \
        --track-renames \
        --create-empty-src-dirs \
        "${syc_src}" \
        "${syc_dst}"
}

_mv_loop()
{
    while IFS= read -r line
    do
        _prn_b "${line} -> ${2}/*"
        mv "${line}" "${2}/"
    done <<< "${1}"
}

# test

_tst_dir()
{
    eval m="${!1}"
    echo $m
    exit
    _prn_b "checking if dir [ $(eval ${!1}) ] exists"
    if [ -d "${!1}" ]
    then
        return 0
    else
        _prn_b "failed to match dir [ ${1} ]; return 1"
        return 1
    fi
    [ $? -eq 1 ] && return 1
    _a2b "$1" "$2" 
    _prn_b "$1 match -> ${2} = ${!2}"
}

# sd

_set_sd_m()
{
    sd_m=$(_find_d_grp "${sd_mnt}/" "${rgx_sd}") # '../' required
}

_set_sd_i()
{
    [ -n "${sd_i}" ] || return 1
    sd_i="$(realpath "${HOME}/${sd_i}")"
}

_sd_r_i()
{
    [ -d "${sd_r}" ] && return 1
    _set_sd_i
    _tst_dir sd_i sd_r
    [ $? -eq 1 ] \
        || _prn_b "sd root has been set as the input arg"
}

_sd_r_m()
{
    [ -d "${sd_r}" ] && return 1
    _prn_l
    _set_sd_m
    _tst_dir sd_m sd_r
    [ $? -eq 1 ] \
        || _prn_b "sd root has been set by regx"
}

_sd_set_dcim_x()
{
    [ -d "${sd_r}" ] || return 1
    sd_dcim="${sd_r}/DCIM/" 
}

# init asynchronous

_sd_ini_imp()
{
    if [ -z "${dst_i}" ]
    then
        dst="$(realpath "${r}/${dst_i_def}")"
    else
        dst="$(realpath "${r}/${dst_i}")"
    fi
}

_sd_ini()
{
    # test sd existsl; set dcim loc
    #[ -d "$sd_dcim" ] && return # TODO: func which returns parent func?
    sd_i=${1}
    dst_i=${2}
    _sd_ini_imp
    _sd_r_i
    _sd_r_m
    _sd_set_dcim_x
    [ -d "${sd_dcim}" ] || _exit1
}

_sd_prn()
{
    _sd_ini "${@}"
    _prn_l
    _prn_b "sd fed as input: ${sd_i}"
    _prn_b "sd regex matched: ${sd_m}"
    _prn_b "dcim set: ${sd_dcim}"
}

# sd_mv

_sd_rs()   { _rs "${sd_dcim}/" "${dst}"; }
   
_sd_bkp_ini()
{
    sd_bkp_src="$(_find_d "${sd_dcim}")"
    mkdir -p ${sd_bkp:="${sd_r}/${sd_bkp_suffix}"}
    _prn_h "sd bkp"
}

_sd_bkp()
{
    [ -d "${sd_dcim}" ] || _sd_ini
    _sd_bkp_ini
    _mv_loop "${sd_bkp_src}" "${sd_bkp}"
}

_sd_mvx ()
{
    _sd_ini "${@}"
    _sd_rs
    _sd_bkp
}

