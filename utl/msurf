# macros

_srt_command()
{
    local srt_subcommand="${1:-}"
    [ "$#" -gt 0 ] && shift

    case "${srt_subcommand}" in
        help|--help|-h|'') _help_srt ;;
        size|s10|s60|s200) _unavailable "srt ${srt_subcommand}" ;;
        dir) _srt_date_dir "${@}" ;;
        sd) _srt_sd "${@}" ;;
        *) _unavailable "srt ${srt_subcommand:-<missing subcommand>}" ;;
    esac
}

_sync_command()
{
    local sync_subcommand="${1:-}"
    [ "$#" -gt 0 ] && shift

    case "${sync_subcommand}" in
        help|--help|-h)    _help_sync ;;
        y21)               _unavailable "sync y21" ;;
        dvb)               _syc_dv_b "${@}" ;;
        g1)                _syc_g1_x "${@}" ;;
        o1|a)              _syc_o1_x "${@}" ;;
        *)                 _syc_o1_x "${@}" ;;
    esac
}

_macro_command()
{
    local macro_subcommand="${1:-}"
    [ "$#" -gt 0 ] && shift

    case "${macro_subcommand}" in
        help|--help|-h|'') _help_macro ;;
        a) _all_xa "${@}" ;;
        b) _all_xb "${@}" ;;
        c) _all_xc "${@}" ;;
        sd) _sd_command all "${@}" ;;
        *) _unavailable "macro ${macro_subcommand:-<missing subcommand>}" ;;
    esac
}

_unavailable()
{
    _prn_b "$1 is not implemented; see 'msurf help' for supported commands"
    return 2
}

_client_command()
{
    case "${1:-}" in
        help|--help|-h|'') _help_client ;;
        *) _mv2cl "${@}" ;;
    esac
}

_help_sd()
{
    cat <<'EOF'
SD-card commands:
  sd mount [BLOCK_DEVICE]
      Mount all available unmounted removable-card partitions with udisksctl.
      Built-in MMC readers (for example /dev/mmcblk0p1) are recognised even
      when Linux reports RM=0. Pass a block-device path to mount it explicitly.
      Already-mounted card partitions are reported and left unchanged.
  sd prn [SD_ROOT]
      Show the SD root and DCIM directory selected from SD_ROOT or configured
      automatic discovery (sdx_mntx + rgx_sdx).
  sd cp [--dir DIR] [--subdir SUBDIR] [--source SD_ROOT|--sd SD_ROOT] [--mount]
      Copy the selected SD_ROOT/DCIM into rx/DIR/SUBDIR. Without --dir, use
      dst_i_def from the config; without --source, use configured mounted-card
      discovery. This leaves the SD card unchanged. --mount runs card mounting
      first.
  sd mv [SD_ROOT] [DESTINATION]
  sd mv [--dir DIR] [--subdir SUBDIR] [--source SD_ROOT|--sd SD_ROOT] [--mount]
      Copy and archive. It accepts the same source and destination options as
      `sd cp`; positional arguments remain supported. This moves DCIM
      directories to backup after the copy.
  sd bkp [SD_ROOT]
      Move immediate directories from the selected card's DCIM into its backup
      directory. This changes the card; use only after confirming the import.
  sd all [SD_ROOT] [DESTINATION]
      Sort the card by date, then import and archive its DCIM directories.
      This is the previous `macro sd` workflow.
  sd macro-a [SD_ROOT] [DESTINATION]
      Compatibility handle for the previous macro-A SD workflow.

`sd import` is retained as a compatibility alias for `sd cp`.
EOF
}

_help_sd_cp()
{
    cat <<'EOF'
SD copy command:
  msurf sd cp [--dir DIR] [--subdir SUBDIR] [--source SD_ROOT|--sd SD_ROOT] [--mount]

Copies DCIM into the workspace without changing the card. With no --dir, the
destination is rx/dst_i_def; --subdir is appended when supplied. With no source,
an available SD card is mounted if necessary and discovered from the config.
EOF
}

_help_sd_mv()
{
    cat <<'EOF'
SD copy-and-archive command:
  msurf sd mv [SD_ROOT] [DESTINATION]
  msurf sd mv [--dir DIR] [--subdir SUBDIR] [--source SD_ROOT|--sd SD_ROOT] [--mount]

Copies DCIM into the workspace, then moves the card's remaining DCIM directories
to its configured backup directory. Option destinations resolve like `sd cp`:
--dir is relative to rx, --subdir is appended, and no --dir uses dst_i_def.
EOF
}

_help_srt()
{
    cat <<'EOF'
Sorting commands:
  srt|sr|sz dir DIRECTORY
      Interactively sort files in matching immediate child directories of
      DIRECTORY into date/time-and-suffix directories. Matching uses the
      configured sd_srt_patterns regex.
  srt|sr|sz sd [SD_ROOT]
      Apply the same interactive date sort to the selected card's DCIM.
  srt|sr|sz size|s10|s60|s200
      Reserved legacy size-sorting handles. They are intentionally disabled
      until their file-grouping rules are completed.
EOF
}

_help_client()
{
    cat <<'EOF'
Client transfer:
  cl|client-x SOURCE_DIR CLIENT_ROOT CLIENT_PREFIX
      Move files named with CLIENT_PREFIX from SOURCE_DIR into the matching
      session directory below CLIENT_ROOT. This moves files, not copies them.
EOF
}

_help_sync()
{
    cat <<'EOF'
Remote sync commands (rclone sync; destination-only files may be deleted):
  sy|sync|syc [o1] RELATIVE_PATH
      Sync rx/RELATIVE_PATH to rep_o1_x/RELATIVE_PATH (the default target).
  sy|sync|syc g1 RELATIVE_PATH
      Sync to rep_g1_x.
  sy|sync|syc dvb RELATIVE_PATH
      Sync to rep_dv_b.
EOF
}

_help_macro()
{
    cat <<'EOF'
Legacy macro commands (all can move files on the card):
  macro|m|a|al a [SD_ROOT] [DESTINATION]
      Sort the card by date, import it, then archive its DCIM directories.
  macro|m|a|al b [SD_ROOT] [DESTINATION]
      Alias for macro a, retained for compatibility.
  macro|m|a|al c [SD_ROOT] [DESTINATION] [RELATIVE_SYNC_PATH]
      Run macro b, then sync RELATIVE_SYNC_PATH (or DESTINATION) to o1.
  macro|m|a|al sd [SD_ROOT] [DESTINATION]
      Compatibility alias for `sd all`.
EOF
}

_help()
{
    printf '%s\n' "${prefix}: import, sort, distribute, and archive camera media"
    cat <<'EOF'

Usage:
  msurf COMMAND [ARGUMENTS]

Top-level commands: sd, cp, cl, srt, sync, macro, help

Use `msurf COMMAND help` for command-specific help.
EOF

    _help_sd
    _help_srt
    _help_client
    _help_sync
    _help_macro
}

_no_arg()
{
    _help
}

_main()
{
    if [ "$#" -gt 0 ]
    then
        cmd="${1}"
        shift
    else
        cmd="help"
    fi

    _ini
    _prn_h "msurf"

    case ${cmd} in
        sd)               _sd_command  "${@}" ;;
        cl|client-x)      _client_command "${@}" ;;
        cp|import)        _sd_cp       "${@}" ;;
        sr|srt|sz)        _srt_command   "${@}" ;;
        sy|sync|syc)      _sync_command  "${@}" ;;
        m|macro|a|al)     _macro_command "${@}" ;;
        help|--help|-h)   _help ;;
        *)                _prn_b "unknown command: ${cmd}"; _help; return 2 ;;
    esac
}

_main "${@}"
