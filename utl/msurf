# sort: client profiles

_src_cl_ls()
{
    find "${src_cl_r}" \
        -mindepth 1 -maxdepth 1 -name "*${pattern_cl}\.*"
}

_mv2cl_ini()
{
    src_cl_r="${1}"
    dst_cl_r="${2}"
    pattern_cl="${3}*" # client annotation pattern
    
    dst_cl_d="$(basename "${src_cl_r}")"
    dst_cl_rx="${dst_cl_r}/${dst_cl_d}"
    src_cl_ls=$(_src_cl_ls)
    echo "src $src_cl_r"
    
    if [ -n "${src_cl_ls}" ]
    then
        mkdir -p "${dst_cl_r}"
        mkdir -p "${dst_cl_rx}"
    else
        _prn_b "nothing to move of pattern ${pattern_cl}"
        return 1
    fi
}

_mv2cl_x_ini()
{
    src_cl_i="${1}"
    dst_cl_i="${dst_cl_rx}/$(basename "${src_cl_i}")"
}

_mv2cl_x()
{
    # session(y) -> client(x)
    _mv2cl_x_ini "${1}"
    _prn_b "${src_cl_i} -> ${dst_cl_i}"
    mv "${src_cl_i}" "${dst_cl_i}"
}

_mv2cl_lp()
{
    _prn_b "moving pattern ${pattern_cl}"
    for i in ${src_cl_ls}
    do
        _mv2cl_x "${i}"
    done
}

_mv2cl()
{
    _mv2cl_ini "${@}"
    [ $? -eq 1 ] && return
    _mv2cl_lp
}

