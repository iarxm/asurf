_main()
{
    cmd="${1}" && shift 1

    _ini

    _prn_h "initialise msurf"

    case ${cmd} in
        cl|client-x)      _mv2cl      "${@}" ;;
        sd-bkp|sdbkp)     _sd_bkp     "${@}" ;;
        sd-prn|sdprn)     _sd_prn     "${@}" ;;
        sd-mv|sdmv)       _sd_mvx     "${@}" ;;
        sr|srt|sz)
            cmd_sub="${1}" && shift 1
            case ${cmd_sub} in
                size)   _srt_size     "${@}" ;;
                s10)    _srt_sz10     "${@}" ;;
                s60)    _srt_sz60     "${@}" ;;
                s200)   _srt_sz200    "${@}" ;;
                dir)    _srt_date_dir "${@}" ;; # sort arg dir
                sd)     _srt_sd ;;
            esac
            ;;
        sy|sync|syc)
            cmd_sub="${1}" && shift 1
            case ${cmd_sub} in
                y21)    _syc_year     "${@}" ;;
                dvb)    _syc_dv_b     "${@}" ;;
                g1)     _syc_g1_x     "${@}" ;;
                o1)     _syc_o1_x     "${@}" ;;
                *)      _syc_o1_x     "${@}" ;;
            esac
            ;;
        m|macro|a|al)
            cmd_sub="${1}" && shift 1
            case ${cmd_sub} in
                a)      _all_xa    "${@}"   ;;
                b)      _all_xb    "${@}"   ;;
                c)      _all_xc    "${@}"   ;;
                sd)     _all_sd    "${@}"   ;;
            esac
            ;;
        help)      _help   ;;
        *|noarg)   _no_arg ;;
    esac
}

_main "${@}"
