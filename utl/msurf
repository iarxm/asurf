}

# mv

_srt_size_ini_x()
{
  src_szx="${f}"
  dst_szx="${prfx}${base1}" 
  # todo - extract full path from $src_sz ... 
  # similar to in srt_date..
 }

_srt_siz_mv_x() { mv "${src_szx}" "${dst_szx}"; }

_srt_siz_mv()
{
    _srt_size_ini_x "${@}"
    echo "${dst_szx}"
    exit
    _srt_siz_mv_x
}

# loop

_srt_siz_ls_x()
{
    find "${src_sz}" \
        -mindepth 1 -maxdepth 1 \
        -size "+${dmin}" -size "-${dmax}" \
        -type f -exec realpath {} \; |\
        \
        grep -v jpg
}

_srt_siz_ls() { sz_ls="$(_srt_siz_ls_x)"; }

_srt_siz_test()
{
    _prn_b "src: ${srt_sz}" "dmax: ${dmax}" "dmin: ${dmin}"
    _prn_b "matched files:" "${sz_ls}"
    
    [ -d "${src_x}" ] && return
    _prn_b "no directory; exiting"
    exit 1
}

_srt_siz_confirm()
{
    printf "Rename files based on size? y/n \n"
    read -r confirm
    
    [ "${confirm}" = "y" ] && return
    printf "Exiting on -no-"
    exit 1
}

_srt_siz_lpx()
{
    while read -r f
    do
        _srt_siz_mv "${f}"
    done <<< "${sz_ls}"
}

# control

_srt_size()
{
    _srt_siz_ini "${@}"
    _srt_siz_ls
    _srt_siz_test
    _srt_sia_confirm
